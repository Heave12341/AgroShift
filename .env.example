# ROTATION IQ - Backend Environment Configuration Example
# Copy this file to .env for local deployment or configure these keys in your hosting platform (Render/Railway).

# NASA POWER & ORNL DAAC Configuration
ROTATION_IQ_WARM_CACHE=1
ANALYSIS_ALPHA=0.05
ANALYSIS_MIN_COMPLETENESS=0.9
ANALYSIS_BASELINE_START=1991
ANALYSIS_BASELINE_END=2020

# CORS Configuration (comma-separated origins)
# For production, set this to every deployed frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://heave12341.github.io,https://vasundhara.earth,https://www.vasundhara.earth,https://dashboard.vasundhara.earth

# Server Port
PORT=8000
ENVIRONMENT=development

# Keep this secret on the backend; never add it to a VITE_ frontend variable.
